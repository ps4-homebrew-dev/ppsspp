From ee70436dd1fa6bc28b1f9105f9fc342e095bdbb7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?John=20T=C3=B6rnblom?= <john.tornblom@gmail.com>
Date: Tue, 20 Oct 2026 11:41:24 +0000
Subject: [PATCH 09/12] SDL: no fork()ed helpers on the PS4

portable-file-dialogs finds zenity, kdialog and the like by fork()ing and
running /bin/sh, and OpenFileInEditor and the URL handlers run xdg-open
with system(). A PS4 app has no shell, and fork() there copies the whole
process, GPU mappings and all; the child's exit() even runs Mesa's atexit
handlers. The menu queries the file browser property while it builds its
views, so it never appeared.

Report no native file or folder browser and no editor (PPSSPP uses its own
browser then), open URLs with SDL_OpenURL(), which the PS4 SDL port sends
to the system's web browser, and don't try to open an email client.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01P3uAWaEfvY2JvhAv7RuSyc
---
 SDL/SDLMain.cpp | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/SDL/SDLMain.cpp b/SDL/SDLMain.cpp
index 73a2e06..a2f80b7 100644
--- a/SDL/SDLMain.cpp
+++ b/SDL/SDLMain.cpp
@@ -521,6 +521,9 @@ void System_LaunchUrl(LaunchUrlType urlType, std::string_view url) {
 		WebWifiConfig conf;
 		webWifiCreate(&conf, NULL, std::string(url).c_str(), uuid, 0);
 		webWifiShow(&conf, NULL);
+#elif PPSSPP_PLATFORM(PS4)
+		// The SDL port opens the system's web browser.
+		SDL_OpenURL(std::string(url).c_str());
 #elif defined(MOBILE_DEVICE)
 		INFO_LOG(Log::System, "Would have gone to %.*s but LaunchBrowser is not implemented on this platform", STR_VIEW(url));
 #elif defined(_WIN32)
@@ -539,7 +542,7 @@ void System_LaunchUrl(LaunchUrlType urlType, std::string_view url) {
 	}
 	case LaunchUrlType::EMAIL_ADDRESS:
 	{
-#if defined(MOBILE_DEVICE)
+#if defined(MOBILE_DEVICE) || PPSSPP_PLATFORM(PS4)
 		INFO_LOG(Log::System, "Would have opened your email client for %.*s but LaunchEmail is not implemented on this platform", STR_VIEW(url));
 #elif defined(_WIN32)
 		std::wstring mailto = std::wstring(L"mailto:") + ConvertUTF8ToWString(url);
@@ -757,7 +760,11 @@ bool System_GetPropertyBool(SystemProperty prop) {
 	case SYSPROP_CAN_JIT:
 		return true;
 	case SYSPROP_SUPPORTS_OPEN_FILE_IN_EDITOR:
+#if PPSSPP_PLATFORM(PS4)
+		return false;  // There is no xdg-open, nor a shell to run it.
+#else
 		return true;  // FileUtil.cpp: OpenFileInEditor
+#endif
 #ifndef HTTPS_NOT_AVAILABLE
 	case SYSPROP_SUPPORTS_HTTPS:
 		return !g_Config.bDisableHTTPS;
@@ -766,6 +773,10 @@ case SYSPROP_HAS_FOLDER_BROWSER:
 case SYSPROP_HAS_FILE_BROWSER:
 #if PPSSPP_PLATFORM(MAC)
 		return true;
+#elif PPSSPP_PLATFORM(PS4)
+		// portable-file-dialogs looks for zenity and friends with fork() and
+		// /bin/sh, which a PS4 app can't do. Use PPSSPP's own browser.
+		return false;
 #else
 		return pfd::settings::available();
 #endif
